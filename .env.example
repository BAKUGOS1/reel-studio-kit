# Copy this file to .env (already git-ignored) and fill in the values.
# Never paste keys into chat, commit them, or put them in prompts.

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
# Needs a paid plan for commercial use and for Voice Library voices over the API.
ELEVENLABS_API_KEY=

# Optional. Default model for reel voices. eleven_v3 understands the [audio tags] in our scripts;
# eleven_v4 is newer (tags too, but only stability/similarity settings). Test both on one line first.
ELEVENLABS_MODEL=eleven_v3

# Optional, only for AI-generated footage in the video-studio skill: https://fal.ai/dashboard/keys
FAL_KEY=
